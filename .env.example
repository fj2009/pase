# Base de datos local de desarrollo (Docker, puerto 5435)
DATABASE_URL=postgres://pase:pase_local_owner@127.0.0.1:5435/pase
DATABASE_APP_URL=postgres://pase_app:pase_local_app@127.0.0.1:5435/pase

# Cadena aleatoria larga para firmar cookies de mesa. Generar con: openssl rand -hex 32
SESSION_SECRET=cambia-esta-cadena-por-una-aleatoria-de-64-hexadecimales

# URL pública de la aplicación (se usa en los QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3010
APP_TIMEZONE=Europe/Madrid

# Entorno: development | production | test
PASE_ENV=development
