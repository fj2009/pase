{
  "name": "pase",
  "version": "0.1.0",
  "private": true,
  "description": "Pase · plataforma de gestión hostelera, carta digital y tiempos de cocina",
  "scripts": {
    "dev": "next dev --port 3010",
    "build": "next build",
    "start": "next start --port 3010",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset.mjs",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "print:agent": "node agent/print-agent.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "next": "15.5.28",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.23",
    "dotenv": "18.0.9",
    "postcss": "8.5.7",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
